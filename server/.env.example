# Copy to .env and fill in. .env is gitignored; never commit it.
PORT=8787

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

ELEVENLABS_API_KEY=
# Any voice from your ElevenLabs voice library; multilingual voices work best.
ELEVENLABS_VOICE_ID=
# Optional: a different voice for Spanish (e.g. a Latin American voice). Falls back to ELEVENLABS_VOICE_ID.
ELEVENLABS_VOICE_ID_ES=
# Optional overrides (defaults shown):
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
